{
  "name": "cumpleia-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern .next/ --ignore-pattern test-results/ --ignore-pattern playwright-report/",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:eipd-client": "playwright test e2e/eipd-api-client.spec.ts e2e/child-adolescent-editor.spec.ts",
    "test:eipd-consultation": "playwright test e2e/eipd-consultation.spec.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "next": "15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
